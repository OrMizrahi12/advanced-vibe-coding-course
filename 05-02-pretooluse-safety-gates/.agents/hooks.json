{
  "lifecycle-tracer": {
    "enabled": true,
    "SessionStart": [{ "command": "../scripts/hook-logger.py", "timeout": 5 }],
    "PostToolUse": [{
      "matcher": "(view|read|list|find|grep)_.*|run_command",
      "hooks": [{ "command": "../scripts/hook-logger.py", "timeout": 5 }]
    }],
    "Stop": [{ "command": "../scripts/hook-logger.py", "timeout": 5 }]
  },
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [{
      "matcher": "run_command|(view|read|grep|find|list)_.*",
      "hooks": [{ "command": "../scripts/pretool-guard.py", "timeout": 5 }]
    }]
  }
}
